{
  "name": "@strommen-byu/react-web-app",
  "version": "0.1.3-alpha.0",
  "private": true,
  "description": "React App for strommenbyu.com web application.",
  "homepage": "https://github.com/jpstrommen95/strommen-byu-app#readme",
  "bugs": {
    "url": "https://github.com/jpstrommen95/strommen-byu-app/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpstrommen95/strommen-byu-app.git"
  },
  "license": "MIT",
  "author": "jpstrommen95 <55213152+jpstrommen95@users.noreply.github.com>",
  "main": "lib/index.js",
  "scripts": {
    "build": "npx react-scripts build",
    "build:ci": "npm run build",
    "predeploy": "npm run local-checks",
    "deploy": "node ./scripts/deploy.js",
    "eject": "npx react-scripts eject",
    "hello-world": "echo Hello World!",
    "lint": "npx eslint . --ext .js,.jsx --max-warnings 0",
    "lint:ci": "npm run lint",
    "lint:fix": "npm run lint -- --fix",
    "lint:quiet": "npm run lint -- --quiet",
    "local-checks": "npm run build && npm run lint && npm run test:ci && echo 'Local checks passed!'",
    "serve": "npx serve -s build -l 3001",
    "sort-package-json": "npx sort-package-json",
    "start": "npx react-scripts start",
    "test": "npx react-scripts test",
    "test:ci": "npx react-scripts test -- --config=jest.config.js --ci"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "dependencies": {
    "@strommen-byu/core": "^0.1.3-alpha.0",
    "archiver": "^7.0.1",
    "ordinal": "^1.0.3",
    "prop-types": "^15.8.1",
    "react": "^18.1.0",
    "react-dom": "^18.1.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@testing-library/react": "^16.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
