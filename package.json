{
  "name": "strommen-byu-app",
  "version": "0.1.0",
  "private": true,
  "homepage": "http://strommenbyu.com",
  "scripts": {
    "build": "craco build",
    "build:ci": "npm run build",
    "predeploy": "npm run local-checks",
    "deploy": "node ./scripts/deploy.js",
    "eject": "react-scripts eject",
    "lint": "npx eslint . --ext .js,.jsx --max-warnings 0",
    "lint:ci": "npm run lint",
    "lint:fix": "npm run lint -- --fix",
    "lint:quiet": "npm run lint -- --quiet",
    "local-checks": "npm run build && npm run lint && npm run test:ci && echo 'Local checks passed!'",
    "serve": "npx serve -s build -l 3001",
    "start": "craco start",
    "test:ci": "craco test -- --config=jest.config.js --ci",
    "test:local": "craco test"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "dependencies": {
    "@craco/craco": "^7.1.0",
    "archiver": "^7.0.1",
    "assert": "^2.1.0",
    "browserify-fs": "^1.0.0",
    "bunyan": "^1.8.15",
    "dtrace-provider": "^0.8.8",
    "ordinal": "^1.0.3",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "prop-types": "^15.8.1",
    "react": "^18.1.0",
    "react-dom": "^18.1.0",
    "react-scripts": "5.0.1",
    "stream-browserify": "^3.0.0",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@babel/core": "^7.24.6",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/preset-env": "^7.24.6",
    "@babel/preset-react": "^7.24.6",
    "@jest/globals": "^29.7.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.1.1",
    "@testing-library/user-event": "^13.5.0",
    "eslint": "^8.2.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-react": "^7.28.0",
    "eslint-plugin-react-hooks": "^4.3.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "sort-package-json": "^2.10.0"
  }
}
