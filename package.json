{
  "name": "strommen-byu-app",
  "homepage": "http://strommenbyu.com",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.1.1",
    "@testing-library/user-event": "^13.5.0",
    "archiver": "^7.0.1",
    "ordinal": "^1.0.3",
    "prop-types": "^15.8.1",
    "react-dom": "^18.1.0",
    "react-scripts": "5.0.1",
    "react": "^18.1.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "build": "react-scripts build",
    "build:ci": "npm run build",
    "deploy": "node ./scripts/deploy.js",
    "eject": "react-scripts eject",
    "lint": "npx eslint . --ext .js,.jsx --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "lint:quiet": "npm run lint -- --quiet",
    "lint:ci": "npm run lint",
    "local-checks": "npm run build && npm run lint && npm run test -- --watchAll=false && echo 'Local checks passed!'",
    "predeploy": "npm run local-checks",
    "serve": "npx serve -s build -l 3001",
    "start": "react-scripts start",
    "test": "react-scripts test",
    "test:ci": "npm run test -- --testResultsProcessor=\"jest-junit\" --watchAll=false --ci --coverage"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "eslint": "^8.2.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-react": "^7.28.0",
    "eslint-plugin-react-hooks": "^4.3.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0"
  }
}
