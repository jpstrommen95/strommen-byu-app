{
  "$schema": "node_modules/lerna/schemas/lerna-schema.json",
  "version": "0.0.1-alpha.1",
  "npmClient": "npm",
  "command": {
    "run": {
      "stream": true
    },
    "publish": {
      "conventionalCommits": true,
      "message": "chore(release): publish"
    }
  },
  "packages": [
    "packages/*"
  ],
  "registry": "https://npm.pkg.github.com",
  "loglevel": "info"
}